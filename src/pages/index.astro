---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { site } from '../data/site';

const siteUrl = site.url.replace(/\/?$/, '/');
const logoUrl = new URL('/logo-arte-com-pipoca.png', site.url).href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			name: site.nome,
			url: siteUrl,
		},
		{
			'@type': 'Organization',
			name: site.nome,
			url: siteUrl,
			logo: logoUrl,
			founder: {
				'@type': 'Person',
				name: 'Senna Ricarte',
			},
			contactPoint: {
				'@type': 'ContactPoint',
				contactType: 'customer support',
				telephone: '+55-11-96148-5763',
				email: site.emailContato,
				availableLanguage: 'Portuguese',
			},
		},
	],
};
---

<BaseLayout
	title="Arte Com Pipoca"
	description="Resenhas, listas e análises de cinema, séries, quadrinhos e música."
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<section class="mx-auto flex max-w-6xl flex-col items-start px-4 py-16 md:px-6">
		<h1 class="sr-only">Arte Com Pipoca</h1>
		<Logo width={420} class="h-auto w-full max-w-md md:max-w-lg" />
	</section>
</BaseLayout>
