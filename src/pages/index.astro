---
import type { ImageMetadata } from 'astro';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CardPost from '../components/CardPost.astro';
import home from '../data/home.json';
import { site } from '../data/site';
import {
	chavePost,
	getPorEditoria,
	getMaisRecente,
	getPostsPublicadosOrdenados,
	getResenhas,
	hrefPost,
	nomeEditoria,
	nomeTipoResenha,
	rotuloCapaArtigo,
	rotuloCapaResenha,
	rotuloEditoriasSite,
	TIPO_RESENHA_PARA_EDITORIA,
	type EditoriaId,
	type PostPorEditoria,
} from '../lib/conteudo';

const siteUrl = site.url.replace(/\/?$/, '/');
const logoUrl = new URL('/logo-arte-com-pipoca.png', site.url).href;

type DestaqueResolvido = {
	chave: string;
	id: string;
	kind: 'artigo' | 'resenha';
	titulo: string;
	href: string;
	description: string;
	autorNome: string;
	pubDate: Date;
	rotulo: string;
	rotuloCapa: string;
	editoria: EditoriaId;
	nota?: number;
	cover?: ImageMetadata;
	coverAlt?: string;
	coverCredito?: string;
	coverLicencaUrl?: string;
	coverPosicao?: string;
	cartaz?: ImageMetadata;
	cartazAlt?: string;
	cartazCredito?: string;
	temCoverReal: boolean;
};

const usados = new Set<string>();

async function resolverPost(item: PostPorEditoria): Promise<DestaqueResolvido> {
	const autor = await getEntry(item.entry.data.autor);

	if (item.kind === 'artigo') {
		return {
			chave: `artigos/${item.entry.id}`,
			id: item.entry.id,
			kind: 'artigo',
			titulo: item.entry.data.title,
			href: `/${item.entry.data.editoria}/${item.entry.id}/`,
			description: item.entry.data.description,
			autorNome: autor?.data.nome ?? 'Autor',
			pubDate: item.entry.data.pubDate,
			rotulo: nomeEditoria(item.entry.data.editoria),
			rotuloCapa: rotuloCapaArtigo(item.entry.data.editoria),
			editoria: item.entry.data.editoria,
			cover: item.entry.data.cover,
			coverAlt: item.entry.data.coverAlt,
			coverCredito: item.entry.data.coverCredito,
			coverLicencaUrl: item.entry.data.coverLicencaUrl,
			coverPosicao: item.entry.data.coverPosicao,
			cartaz: item.entry.data.cartaz,
			cartazAlt: item.entry.data.cartazAlt,
			cartazCredito: item.entry.data.cartazCredito,
			temCoverReal: Boolean(item.entry.data.cover && item.entry.data.coverAlt),
		};
	}

	const editoria = TIPO_RESENHA_PARA_EDITORIA[item.entry.data.tipo];
	return {
		chave: `resenhas/${item.entry.id}`,
		id: item.entry.id,
		kind: 'resenha',
		titulo: item.entry.data.title,
		href: `/resenhas/${item.entry.id}/`,
		description: item.entry.data.description,
		autorNome: autor?.data.nome ?? 'Autor',
		pubDate: item.entry.data.pubDate,
		rotulo: nomeTipoResenha(item.entry.data.tipo),
		rotuloCapa: rotuloCapaResenha(item.entry.data),
		editoria,
		nota: item.entry.data.nota,
		cover: item.entry.data.cover,
		coverAlt: item.entry.data.coverAlt,
		coverCredito: item.entry.data.coverCredito,
		coverLicencaUrl: item.entry.data.coverLicencaUrl,
		coverPosicao: item.entry.data.coverPosicao,
		cartaz: item.entry.data.cartaz,
		cartazAlt: item.entry.data.cartazAlt,
		cartazCredito: item.entry.data.cartazCredito,
		temCoverReal: Boolean(
			(item.entry.data.cover && item.entry.data.coverAlt) ||
				(item.entry.data.cartaz && item.entry.data.cartazAlt),
		),
	};
}

/** Resolve um slug "colecao/id" do home.json; ignora draft/inexistente. */
async function resolverDestaque(
	slug: string,
): Promise<DestaqueResolvido | null> {
	const [colecao, ...rest] = slug.split('/');
	const id = rest.join('/');
	if (!colecao || !id) {
		console.warn(`[home] destaque inválido: ${slug}`);
		return null;
	}

	if (colecao === 'artigos') {
		const entry = await getEntry('artigos', id);
		if (!entry || entry.data.draft) {
			console.warn(`[home] destaque ignorado (ausente ou draft): ${slug}`);
			return null;
		}
		return resolverPost({ kind: 'artigo', entry });
	}

	if (colecao === 'resenhas') {
		const entry = await getEntry('resenhas', id);
		if (!entry || entry.data.draft) {
			console.warn(`[home] destaque ignorado (ausente ou draft): ${slug}`);
			return null;
		}
		return resolverPost({ kind: 'resenha', entry });
	}

	console.warn(`[home] destaque com coleção desconhecida: ${slug}`);
	return null;
}

const postsRecentes = await getPostsPublicadosOrdenados();
const maisRecente = await getMaisRecente();

let destaquePrincipal =
	home.destaqueFixo && home.destaqueFixo.trim()
		? await resolverDestaque(home.destaqueFixo)
		: null;

if (!destaquePrincipal && maisRecente) {
	destaquePrincipal = await resolverPost(maisRecente);
}

if (destaquePrincipal) usados.add(destaquePrincipal.chave);

const destaquesMenores: DestaqueResolvido[] = [];
for (const slug of home.destaques) {
	const item = await resolverDestaque(slug);
	if (!item || usados.has(item.chave)) continue;
	destaquesMenores.push(item);
	usados.add(item.chave);
	if (destaquesMenores.length >= 3) break;
}

for (const post of postsRecentes) {
	if (destaquesMenores.length >= 3) break;
	const item = await resolverPost(post);
	if (usados.has(item.chave)) continue;
	destaquesMenores.push(item);
	usados.add(item.chave);
}

const resenhas = await getResenhas();
const criticasRecentes = resenhas
	.filter((r) => !usados.has(`resenhas/${r.id}`))
	.slice(0, 3);

const autoresCriticas = await Promise.all(
	criticasRecentes.map(async (entry) => {
		const autor = await getEntry(entry.data.autor);
		usados.add(`resenhas/${entry.id}`);
		return {
			id: entry.id,
			nome: autor?.data.nome ?? 'Autor',
		};
	}),
);
const autorCriticaPorId = Object.fromEntries(
	autoresCriticas.map((a) => [a.id, a.nome]),
);

const editoriasHome: EditoriaId[] = [
	'cinema',
	'series',
	'quadrinhos',
	'musica',
];

type BlocoEditoria = {
	id: EditoriaId;
	nome: string;
	itens: {
		item: PostPorEditoria;
		autorNome: string;
	}[];
};

const blocosEditoria: BlocoEditoria[] = [];

for (const ed of editoriasHome) {
	const lista = await getPorEditoria(ed);
	const escolhidos: PostPorEditoria[] = [];
	for (const post of lista) {
		const chave = chavePost(post);
		if (usados.has(chave)) continue;
		escolhidos.push(post);
		if (escolhidos.length >= 3) break;
	}
	if (escolhidos.length === 0) continue;

	const comAutor = await Promise.all(
		escolhidos.map(async (item) => {
			usados.add(chavePost(item));
			const autor = await getEntry(item.entry.data.autor);
			return {
				item,
				autorNome: autor?.data.nome ?? 'Autor',
			};
		}),
	);

	blocosEditoria.push({
		id: ed,
		nome: nomeEditoria(ed),
		itens: comAutor,
	});
}

function propsCardEditoria(
	item: PostPorEditoria,
	autorNome: string,
	bloco: BlocoEditoria,
) {
	const base = {
		titulo: item.entry.data.title,
		href: hrefPost(item),
		idPost: item.entry.id,
		description: item.entry.data.description,
		autorNome,
		pubDate: item.entry.data.pubDate,
		editoria: bloco.id,
		cover: item.entry.data.cover,
		coverAlt: item.entry.data.coverAlt,
		coverCredito: item.entry.data.coverCredito,
		coverLicencaUrl: item.entry.data.coverLicencaUrl,
		coverPosicao: item.entry.data.coverPosicao,
		cartaz: item.entry.data.cartaz,
		cartazAlt: item.entry.data.cartazAlt,
		cartazCredito: item.entry.data.cartazCredito,
		nivelTitulo: 'h3' as const,
	};
	if (item.kind === 'resenha') {
		return {
			...base,
			rotulo: 'Crítica',
			rotuloCapa: rotuloCapaResenha(item.entry.data),
			nota: item.entry.data.nota,
		};
	}
	return {
		...base,
		rotulo: bloco.nome,
		rotuloCapa: rotuloCapaArtigo(item.entry.data.editoria),
	};
}

type GuiaGrupo = {
	titulo: string;
	hub: string;
	itens: { titulo: string; href: string }[];
};

/** Guias e listas (home.json): só entram artigos publicados. */
const guiasHome: GuiaGrupo[] = [];
for (const grupo of home.guias ?? []) {
	const itens: GuiaGrupo['itens'] = [];
	for (const slug of grupo.itens) {
		const [colecao, ...rest] = slug.split('/');
		const id = rest.join('/');
		if (colecao !== 'artigos') continue;
		const entry = await getEntry('artigos', id);
		if (!entry || entry.data.draft) {
			console.warn(`[home] guia ignorado (ausente ou draft): ${slug}`);
			continue;
		}
		itens.push({
			titulo: entry.data.title,
			href: `/${entry.data.editoria}/${entry.id}/`,
		});
	}
	if (itens.length > 0) guiasHome.push({ titulo: grupo.titulo, hub: grupo.hub, itens });
}

/** Autores com texto publicado, do mais ativo para o menos ativo. */
const [artigosPublicados, autoresColecao] = await Promise.all([
	getPostsPublicadosOrdenados(),
	getCollection('autores'),
]);
const textosPorAutor = new Map<string, number>();
for (const post of artigosPublicados) {
	const idAutor = post.entry.data.autor.id;
	textosPorAutor.set(idAutor, (textosPorAutor.get(idAutor) ?? 0) + 1);
}
const autoresHome = autoresColecao
	.map((a) => ({
		id: a.id,
		nome: a.data.nome,
		total: textosPorAutor.get(a.id) ?? 0,
	}))
	.filter((a) => a.total > 0)
	.sort((a, b) => b.total - a.total || a.nome.localeCompare(b.nome, 'pt-BR'));

const introducao = home.introducao;
const seoDescription = `${rotuloEditoriasSite()} com olhar de fã e rigor de crítica. Arte Com Pipoca: no ar desde 2013, com acervo revisado e novidades pela frente.`;
const seoLen = [...seoDescription].length;
if (seoLen < 140 || seoLen > 160) {
	console.warn(
		`[home] description SEO fora de 140–160 (${seoLen}): ${seoDescription}`,
	);
}

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			name: site.nome,
			url: siteUrl,
			potentialAction: {
				'@type': 'SearchAction',
				target: {
					'@type': 'EntryPoint',
					urlTemplate: `${siteUrl}busca/?q={search_term_string}`,
				},
				'query-input': 'required name=search_term_string',
			},
		},
		{
			'@type': 'Organization',
			name: site.nome,
			url: siteUrl,
			logo: logoUrl,
			publishingPrinciples: `${siteUrl}politica-editorial/`,
			founder: {
				'@type': 'Person',
				name: 'Senna Ricarte',
			},
			contactPoint: {
				'@type': 'ContactPoint',
				contactType: 'customer support',
				telephone: '+55-11-96148-5763',
				email: site.emailContato,
				availableLanguage: 'Portuguese',
			},
		},
	],
};

const linkSection =
	'font-medium text-pipoca underline-offset-2 transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca';
---

<BaseLayout
	title={`Arte Com Pipoca | ${rotuloEditoriasSite()}`}
	description={seoDescription}
>
	<script
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	/>

	<div class="mx-auto max-w-6xl px-4 py-10 md:px-6 md:py-14">
		<section aria-labelledby="home-titulo">
			<h1
				id="home-titulo"
				class="font-display text-4xl tracking-wide text-text md:text-5xl lg:text-6xl"
			>
				{rotuloEditoriasSite()} desde 2013
			</h1>
			<p class="mt-5 max-w-2xl text-base leading-relaxed text-muted md:text-lg">
				{introducao}
			</p>
			<p class="mt-4">
				<a href="/sobre/" class={`text-sm text-muted ${linkSection}`}>
					Conheça nossa história
				</a>
			</p>
		</section>

		{
			(destaquePrincipal || destaquesMenores.length > 0) && (
				<section class="mt-10 md:mt-12" aria-labelledby="destaques-titulo">
					<h2
						id="destaques-titulo"
						class="font-display text-3xl tracking-wide text-pipoca md:text-4xl"
					>
						Destaques
					</h2>
					{destaquePrincipal && (
						<div class="mt-6">
							<CardPost
								titulo={destaquePrincipal.titulo}
								href={destaquePrincipal.href}
								idPost={destaquePrincipal.id}
								description={destaquePrincipal.description}
								autorNome={destaquePrincipal.autorNome}
								pubDate={destaquePrincipal.pubDate}
								rotulo={destaquePrincipal.rotulo}
								rotuloCapa={destaquePrincipal.rotuloCapa}
								editoria={destaquePrincipal.editoria}
								nota={destaquePrincipal.nota}
								cover={destaquePrincipal.cover}
								coverAlt={destaquePrincipal.coverAlt}
								coverCredito={destaquePrincipal.coverCredito}
								coverLicencaUrl={destaquePrincipal.coverLicencaUrl}
								coverPosicao={destaquePrincipal.coverPosicao}
								cartaz={destaquePrincipal.cartaz}
								cartazAlt={destaquePrincipal.cartazAlt}
								cartazCredito={destaquePrincipal.cartazCredito}
								capaPrioridade={Boolean(
									destaquePrincipal.cover && destaquePrincipal.coverAlt,
								)}
								destaque
								largo
								nivelTitulo="h3"
							/>
						</div>
					)}
					{
						destaquesMenores.length > 0 && (
							<div class="mt-8 grid grid-cols-1 gap-x-6 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
								{destaquesMenores.map((d) => (
									<CardPost
										titulo={d.titulo}
										href={d.href}
										idPost={d.id}
										description={d.description}
										autorNome={d.autorNome}
										pubDate={d.pubDate}
										rotulo={d.rotulo}
										rotuloCapa={d.rotuloCapa}
										editoria={d.editoria}
										nota={d.nota}
										cover={d.cover}
										coverAlt={d.coverAlt}
										coverCredito={d.coverCredito}
										coverLicencaUrl={d.coverLicencaUrl}
										coverPosicao={d.coverPosicao}
										cartaz={d.cartaz}
										cartazAlt={d.cartazAlt}
										cartazCredito={d.cartazCredito}
										destaque
										nivelTitulo="h3"
									/>
								))}
							</div>
						)
					}
				</section>
			)
		}

		{
			guiasHome.length > 0 && (
				<section class="mt-12 md:mt-14" aria-labelledby="guias-titulo">
					<h2
						id="guias-titulo"
						class="font-display text-3xl tracking-wide text-pipoca md:text-4xl"
					>
						Guias e listas de 2026
					</h2>
					<div class="mt-6 grid grid-cols-1 gap-x-8 gap-y-8 md:grid-cols-2">
						{guiasHome.map((grupo) => (
							<div>
								<h3 class="text-lg font-bold text-text">
									<a href={grupo.hub} class={linkSection}>
										{grupo.titulo}
									</a>
								</h3>
								<ul class="mt-3 flex flex-col gap-2">
									{grupo.itens.map((it) => (
										<li>
											<a
												href={it.href}
												class="text-muted underline-offset-2 transition-colors hover:text-pipoca hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca"
											>
												{it.titulo}
											</a>
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
				</section>
			)
		}

		{
			criticasRecentes.length > 0 && (
				<section class="mt-12 md:mt-14" aria-labelledby="criticas-titulo">
					<div class="flex flex-wrap items-baseline justify-between gap-3">
						<h2
							id="criticas-titulo"
							class="font-display text-3xl tracking-wide text-pipoca md:text-4xl"
						>
							Críticas recentes
						</h2>
						<a href="/resenhas/" class={`text-sm ${linkSection}`}>
							Ver todas as críticas
						</a>
					</div>
					<div class="mt-6 grid grid-cols-1 gap-x-6 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
						{criticasRecentes.map((entry) => (
							<CardPost
								titulo={entry.data.title}
								href={`/resenhas/${entry.id}/`}
								idPost={entry.id}
								description={entry.data.description}
								autorNome={autorCriticaPorId[entry.id] ?? 'Autor'}
								pubDate={entry.data.pubDate}
								rotulo={nomeTipoResenha(entry.data.tipo)}
								rotuloCapa={rotuloCapaResenha(entry.data)}
								editoria={TIPO_RESENHA_PARA_EDITORIA[entry.data.tipo]}
								nota={entry.data.nota}
								cover={entry.data.cover}
								coverAlt={entry.data.coverAlt}
								coverCredito={entry.data.coverCredito}
								coverLicencaUrl={entry.data.coverLicencaUrl}
								coverPosicao={entry.data.coverPosicao}
								cartaz={entry.data.cartaz}
								cartazAlt={entry.data.cartazAlt}
								cartazCredito={entry.data.cartazCredito}
								nivelTitulo="h3"
							/>
						))}
					</div>
				</section>
			)
		}

		{
			blocosEditoria.map((bloco) => (
				<section
					class="mt-12 md:mt-14"
					aria-labelledby={`editoria-${bloco.id}`}
				>
					<div class="flex flex-wrap items-baseline justify-between gap-3">
						<h2
							id={`editoria-${bloco.id}`}
							class="font-display text-3xl tracking-wide text-pipoca md:text-4xl"
						>
							<a
								href={`/${bloco.id}/`}
								class="transition-colors hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca"
							>
								{bloco.nome}
							</a>
						</h2>
						<a href={`/${bloco.id}/`} class={`text-sm ${linkSection}`}>
							Mais de {bloco.nome}
						</a>
					</div>
					<div class="mt-6 grid grid-cols-1 gap-x-6 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
						{bloco.itens.map(({ item, autorNome }) => (
							<CardPost {...propsCardEditoria(item, autorNome, bloco)} />
						))}
					</div>
				</section>
			))
		}

		<section
			class="mt-14 border-t border-white/10 pt-8 md:mt-16"
			aria-labelledby="equipe-titulo"
		>
			<h2
				id="equipe-titulo"
				class="font-display text-3xl tracking-wide text-pipoca md:text-4xl"
			>
				Quem escreve
			</h2>
			<ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-base">
				{autoresHome.map((a) => (
					<li>
						<a href={`/autores/${a.id}/`} class={linkSection}>
							{a.nome}
						</a>
					</li>
				))}
			</ul>
			<p class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-base text-muted">
				<a href="/autores/" class={linkSection}>Toda a equipe</a>
				<a href="/politica-editorial/" class={linkSection}>Política editorial</a>
				<a href="/contato/" class={linkSection}>Fale com a gente</a>
			</p>
		</section>
	</div>
</BaseLayout>
