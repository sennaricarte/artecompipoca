---
import { getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CapaPost from '../../components/CapaPost.astro';
import MetaPost from '../../components/MetaPost.astro';
import NotaEditorial from '../../components/NotaEditorial.astro';
import FichaTecnica from '../../components/FichaTecnica.astro';
import {
	formatarData,
	getResenhas,
	nomeTipoResenha,
	rotuloCapaResenha,
	TIPO_RESENHA_PARA_EDITORIA,
	type TipoResenha,
} from '../../lib/conteudo';

export async function getStaticPaths() {
	const resenhas = await getResenhas();
	return resenhas.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<'resenhas'>;
}

const itemReviewedType: Record<TipoResenha, string> = {
	filme: 'Movie',
	serie: 'TVSeries',
	hq: 'Book',
	album: 'MusicAlbum',
};

/**
 * @param {number} min
 * @returns {string}
 */
function duracaoIso8601(min: number): string {
	const h = Math.floor(min / 60);
	const m = min % 60;
	let out = 'PT';
	if (h > 0) out += `${h}H`;
	if (m > 0 || h === 0) out += `${m}M`;
	return out;
}

/**
 * @param {string[]} nomes
 * @returns {{ '@type': string, name: string }[]}
 */
function pessoas(nomes: string[]) {
	return nomes.map((name) => ({ '@type': 'Person', name }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const autorEntry = await getEntry(entry.data.autor);
const autor = {
	id: autorEntry?.id ?? entry.data.autor.id,
	nome: autorEntry?.data.nome ?? 'Autor',
};

const site = Astro.site ?? new URL('https://artecompipoca.net');
const pageUrl = new URL(`/resenhas/${entry.id}/`, site).href;
const autorUrl = new URL(`/autores/${autor.id}/`, site).href;
const seoTitle = entry.data.seoTitle ?? entry.data.title;
const tipoLabel = nomeTipoResenha(entry.data.tipo);
const editoriaCapa = TIPO_RESENHA_PARA_EDITORIA[entry.data.tipo];
const ficha = entry.data.ficha;
const temFichaFactual = Boolean(
	ficha &&
		(ficha.tituloOriginal ||
			ficha.ano != null ||
			ficha.direcao?.length ||
			ficha.roteiro?.length ||
			ficha.elenco?.length ||
			ficha.generos?.length ||
			ficha.duracaoMin != null ||
			ficha.paises?.length ||
			ficha.criadores?.length ||
			ficha.temporadas != null ||
			ficha.emissora ||
			ficha.wikidataId),
);
const temFichaInicio = Boolean(
	ficha && (ficha.sinopse?.trim() || ficha.trailerYoutubeId),
);
const mostrarFichaFim =
	temFichaFactual ||
	Boolean(ficha?.premios?.length) ||
	Boolean(ficha?.curiosidades?.length) ||
	Boolean(ficha?.fontes?.length) ||
	entry.data.tipo === 'filme' ||
	entry.data.tipo === 'serie' ||
	Boolean(entry.data.cartaz && entry.data.cartazAlt);

const ogImage = new URL(`/og/resenhas/${entry.id}.png`, site).href;
const imageLd = ogImage;

const relacionados = (await getResenhas())
	.filter((r) => r.data.tipo === entry.data.tipo && r.id !== entry.id)
	.slice(0, 3);

const itemReviewed: Record<string, unknown> = {
	'@type': itemReviewedType[entry.data.tipo],
	name: entry.data.obra,
};
if (entry.data.anoObra != null) {
	itemReviewed.dateCreated = String(entry.data.anoObra);
}

if (ficha) {
	if (ficha.tituloOriginal) {
		itemReviewed.alternateName = ficha.tituloOriginal;
	}
	const ano = ficha.ano ?? entry.data.anoObra;
	if (ano != null) {
		itemReviewed.datePublished = String(ano);
		itemReviewed.dateCreated = String(ano);
	}
	if (ficha.direcao?.length) {
		itemReviewed.director = pessoas(ficha.direcao);
	}
	if (ficha.elenco?.length) {
		itemReviewed.actor = pessoas(ficha.elenco);
	}
	if (ficha.generos?.length) {
		itemReviewed.genre = ficha.generos;
	}
	if (ficha.duracaoMin != null) {
		itemReviewed.duration = duracaoIso8601(ficha.duracaoMin);
	}
	if (ficha.paises?.length) {
		itemReviewed.countryOfOrigin = ficha.paises.map((name) => ({
			'@type': 'Country',
			name,
		}));
	}
	if (entry.data.tipo === 'serie') {
		if (ficha.criadores?.length) {
			itemReviewed.creator = pessoas(ficha.criadores);
		}
		if (ficha.temporadas != null) {
			itemReviewed.numberOfSeasons = ficha.temporadas;
		}
	}
	if (ficha.wikidataId) {
		itemReviewed.sameAs = `https://www.wikidata.org/wiki/${ficha.wikidataId}`;
	}
	if (ficha.sinopse?.trim()) {
		itemReviewed.description = ficha.sinopse.trim();
	}
	if (ficha.trailerYoutubeId) {
		const id = ficha.trailerYoutubeId;
		itemReviewed.trailer = {
			'@type': 'VideoObject',
			name: `Trailer de ${entry.data.obra}`,
			embedUrl: `https://www.youtube-nocookie.com/embed/${id}`,
			thumbnailUrl: `https://i.ytimg.com/vi_webp/${id}/hqdefault.webp`,
		};
	}
}

const reviewLd: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'Review',
	headline: entry.data.title,
	description: entry.data.description,
	datePublished: entry.data.pubDate.toISOString(),
	author: {
		'@type': 'Person',
		name: autor.nome,
		url: autorUrl,
	},
	itemReviewed,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': pageUrl,
	},
};
if (entry.data.nota != null) {
	reviewLd.reviewRating = {
		'@type': 'Rating',
		ratingValue: entry.data.nota,
		bestRating: 10,
		worstRating: 0,
	};
}
reviewLd.image = imageLd;
---

<BaseLayout
	title={seoTitle}
	description={entry.data.description}
	ogType="article"
	ogImage={ogImage}
	ogImageAlt={entry.data.title}
	publishedTime={entry.data.pubDate.toISOString()}
	modifiedTime={(entry.data.updatedDate ?? entry.data.pubDate).toISOString()}
	noindex={entry.data.draft}
>
	<script
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(reviewLd)}
	/>

	<article class="mx-auto max-w-6xl px-4 py-10 md:px-6">
		<Breadcrumb
			items={[
				{ label: 'Início', href: '/' },
				{ label: 'Resenhas', href: '/resenhas/' },
				{ label: entry.data.title },
			]}
		/>

		<CapaPost
			idPost={entry.id}
			rotulo={rotuloCapaResenha(entry.data)}
			editoria={editoriaCapa}
			cover={entry.data.cover}
			coverAlt={entry.data.coverAlt}
			coverCredito={entry.data.coverCredito}
			coverLicencaUrl={entry.data.coverLicencaUrl}
			coverPosicao={entry.data.coverPosicao}
			nota={entry.data.nota}
			prioridade={Boolean(entry.data.cover && entry.data.coverAlt)}
			sizes="(min-width: 1024px) 720px, 100vw"
			molduraClass="max-h-[480px]"
			class="mt-6"
		/>

		<h1 class="mt-8 font-display text-4xl tracking-wide text-text md:text-5xl">
			{entry.data.title}
		</h1>

		<MetaPost
			autor={autor}
			pubDate={entry.data.pubDate}
			updatedDate={entry.data.updatedDate}
			texto={entry.body ?? ''}
			origem={entry.data.origem}
		/>

		{
			entry.data.nota != null && (
				<p
					class="mt-6 border-l-4 border-pipoca bg-surface px-4 py-3 font-display text-2xl tracking-wide text-pipoca"
					aria-label={`Nota ${entry.data.nota} de 10`}
				>
					Nota: {entry.data.nota}/10
				</p>
			)
		}

		{entry.data.notaEditorial && (
			<NotaEditorial texto={entry.data.notaEditorial} />
		)}

		{
			temFichaInicio && ficha && (
				<FichaTecnica
					ficha={ficha}
					obra={entry.data.obra}
					tipo={entry.data.tipo}
					parte="inicio"
				/>
			)
		}

		{
			!temFichaFactual && (
				<dl class="mt-6 flex flex-wrap gap-x-6 gap-y-2 border-y border-white/10 py-4 text-sm">
					<div>
						<dt class="text-muted">Obra</dt>
						<dd class="font-medium text-text">{entry.data.obra}</dd>
					</div>
					<div>
						<dt class="text-muted">Tipo</dt>
						<dd class="font-medium text-text">{tipoLabel}</dd>
					</div>
					{entry.data.anoObra != null && (
						<div>
							<dt class="text-muted">Ano</dt>
							<dd class="font-medium text-text">{entry.data.anoObra}</dd>
						</div>
					)}
				</dl>
			)
		}

		<div class="conteudo mt-10">
			<Content />
		</div>

		{
			mostrarFichaFim && (
				<FichaTecnica
					ficha={ficha}
					obra={entry.data.obra}
					tipo={entry.data.tipo}
					parte="fim"
					cartaz={entry.data.cartaz}
					cartazAlt={entry.data.cartazAlt}
					cartazCredito={entry.data.cartazCredito}
				/>
			)
		}

		{
			relacionados.length > 0 && (
				<section class="mt-16 border-t border-white/10 pt-10" aria-labelledby="leia-tambem">
					<h2
						id="leia-tambem"
						class="font-display text-2xl tracking-wide text-pipoca"
					>
						Leia também
					</h2>
					<ul class="mt-4 flex flex-col gap-3">
						{relacionados.map((rel) => (
							<li>
								<a
									href={`/resenhas/${rel.id}/`}
									class="group block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca"
								>
									<span class="font-medium text-text transition-colors group-hover:text-pipoca">
										{rel.data.title}
									</span>
									<span class="mt-1 block text-sm text-muted">
										{formatarData(rel.data.pubDate)}
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</article>
</BaseLayout>
