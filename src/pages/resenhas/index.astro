---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CardPost from '../../components/CardPost.astro';
import Paginacao from '../../components/Paginacao.astro';
import {
	fatiaPagina,
	getResenhas,
	nomeTipoResenha,
	rotuloCapaResenha,
	TIPO_RESENHA_PARA_EDITORIA,
	totalPaginas,
} from '../../lib/conteudo';

const resenhas = await getResenhas();
const paginaAtual = 1;
const total = totalPaginas(resenhas.length);
const paginaItens = fatiaPagina(resenhas, paginaAtual);
const vazio = resenhas.length === 0;
const intro =
	'Críticas e opiniões sobre filmes, séries, quadrinhos e álbuns. Leituras com contexto, nota quando couber e espaço para discordar.';
const baseUrl = '/resenhas/';

const autores = await Promise.all(
	paginaItens.map(async (entry) => {
		const autor = await getEntry(entry.data.autor);
		return {
			id: entry.id,
			nome: autor?.data.nome ?? 'Autor',
		};
	}),
);
const autorPorId = Object.fromEntries(autores.map((a) => [a.id, a.nome]));
---

<BaseLayout title="Resenhas" description={intro} noindex={vazio}>
	<section class="mx-auto max-w-6xl px-4 py-10 md:px-6">
		<Breadcrumb
			items={[
				{ label: 'Início', href: '/' },
				{ label: 'Resenhas' },
			]}
		/>
		<h1 class="font-display text-4xl tracking-wide text-text md:text-5xl">
			Resenhas
		</h1>
		<p class="mt-4 max-w-2xl text-muted">{intro}</p>

		{
			vazio ? (
				<p class="mt-10 text-muted">
					As primeiras resenhas chegam em breve.
				</p>
			) : (
				<>
					<div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
						{paginaItens.map((entry) => (
							<CardPost
								titulo={entry.data.title}
								href={`/resenhas/${entry.id}/`}
								idPost={entry.id}
								description={entry.data.description}
								autorNome={autorPorId[entry.id] ?? 'Autor'}
								pubDate={entry.data.pubDate}
								rotulo={nomeTipoResenha(entry.data.tipo)}
								rotuloCapa={rotuloCapaResenha(entry.data)}
								editoria={TIPO_RESENHA_PARA_EDITORIA[entry.data.tipo]}
								nota={entry.data.nota}
								cover={entry.data.cover}
								coverAlt={entry.data.coverAlt}
								coverCredito={entry.data.coverCredito}
								coverLicencaUrl={entry.data.coverLicencaUrl}
								coverPosicao={entry.data.coverPosicao}
							/>
						))}
					</div>
					<Paginacao
						paginaAtual={paginaAtual}
						totalPaginas={total}
						baseUrl={baseUrl}
					/>
				</>
			)
		}
	</section>
</BaseLayout>
