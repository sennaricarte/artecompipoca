---
import { getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CapaPost from '../../components/CapaPost.astro';
import MetaPost from '../../components/MetaPost.astro';
import NotaEditorial from '../../components/NotaEditorial.astro';
import {
	formatarData,
	getArtigos,
	nomeEditoria,
	rotuloCapaArtigo,
} from '../../lib/conteudo';

export async function getStaticPaths() {
	const artigos = await getArtigos();
	return artigos.map((entry) => ({
		params: {
			editoria: entry.data.editoria,
			slug: entry.id,
		},
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<'artigos'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const autorEntry = await getEntry(entry.data.autor);
const autor = {
	id: autorEntry?.id ?? entry.data.autor.id,
	nome: autorEntry?.data.nome ?? 'Autor',
};

const site = Astro.site ?? new URL('https://artecompipoca.net');
const pageUrl = new URL(
	`/${entry.data.editoria}/${entry.id}/`,
	site,
).href;
const autorUrl = new URL(`/autores/${autor.id}/`, site).href;
const editoriaNome = nomeEditoria(entry.data.editoria);
const seoTitle = entry.data.seoTitle ?? entry.data.title;
const dateModified = entry.data.updatedDate ?? entry.data.pubDate;

const ogImage = new URL(`/og/artigos/${entry.id}.png`, site).href;
const imageLd = ogImage;

const relacionados = (await getArtigos())
	.filter(
		(a) =>
			a.data.editoria === entry.data.editoria && a.id !== entry.id,
	)
	.slice(0, 3);

const blogPosting: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: entry.data.title,
	description: entry.data.description,
	datePublished: entry.data.pubDate.toISOString(),
	dateModified: dateModified.toISOString(),
	author: {
		'@type': 'Person',
		name: autor.nome,
		url: autorUrl,
	},
	publisher: {
		'@type': 'Organization',
		name: 'Arte Com Pipoca',
		url: site.href,
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': pageUrl,
	},
};
blogPosting.image = imageLd;

const temCover = Boolean(entry.data.cover && entry.data.coverAlt);
---

<BaseLayout
	title={seoTitle}
	description={entry.data.description}
	ogType="article"
	ogImage={ogImage}
	ogImageAlt={entry.data.title}
	publishedTime={entry.data.pubDate.toISOString()}
	modifiedTime={dateModified.toISOString()}
	noindex={entry.data.draft}
>
	<script
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(blogPosting)}
	/>

	<article class="px-4 py-10 md:px-6">
		<div class="post-corpo mx-auto w-full max-w-[46rem]">
		<Breadcrumb
			items={[
				{ label: 'Início', href: '/' },
				{
					label: editoriaNome,
					href: `/${entry.data.editoria}/`,
				},
				{ label: entry.data.title },
			]}
		/>

		{
			temCover && (
				<CapaPost
					idPost={entry.id}
					rotulo={rotuloCapaArtigo(entry.data.editoria)}
					editoria={entry.data.editoria}
					cover={entry.data.cover}
					coverAlt={entry.data.coverAlt}
					coverCredito={entry.data.coverCredito}
					coverLicencaUrl={entry.data.coverLicencaUrl}
					coverPosicao={entry.data.coverPosicao}
					prioridade
					sizes="(min-width: 736px) 736px, 100vw"
					class="mt-6"
				/>
			)
		}

		<h1 class="mt-8 font-display text-4xl tracking-wide text-text md:text-5xl">
			{entry.data.title}
		</h1>

		<MetaPost
			autor={autor}
			pubDate={entry.data.pubDate}
			updatedDate={entry.data.updatedDate}
			texto={entry.body ?? ''}
			origem={entry.data.origem}
		/>

		{entry.data.notaEditorial && (
			<NotaEditorial texto={entry.data.notaEditorial} />
		)}

		<div class="conteudo mt-10">
			<Content />
		</div>

		{
			relacionados.length > 0 && (
				<section class="mt-16 border-t border-white/10 pt-10" aria-labelledby="leia-tambem">
					<h2
						id="leia-tambem"
						class="font-display text-2xl tracking-wide text-pipoca"
					>
						Leia também
					</h2>
					<ul class="mt-4 flex flex-col gap-3">
						{relacionados.map((rel) => (
							<li>
								<a
									href={`/${rel.data.editoria}/${rel.id}/`}
									class="group block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca"
								>
									<span class="font-medium text-text transition-colors group-hover:text-pipoca">
										{rel.data.title}
									</span>
									<span class="mt-1 block text-sm text-muted">
										{formatarData(rel.data.pubDate)}
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
		</div>
	</article>
</BaseLayout>
