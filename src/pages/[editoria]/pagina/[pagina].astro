---
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CardPost from '../../../components/CardPost.astro';
import Paginacao from '../../../components/Paginacao.astro';
import {
	fatiaPagina,
	getPorEditoria,
	hrefPost,
	nomeEditoria,
	rotuloCapaArtigo,
	rotuloCapaResenha,
	editoriaDePost,
	totalPaginas,
	type EditoriaId,
	type PostPorEditoria,
} from '../../../lib/conteudo';

export async function getStaticPaths() {
	const editorias = await getCollection('editorias');
	/** @type {{ params: { editoria: string; pagina: string }; props: { editoria: CollectionEntry<'editorias'>; pagina: number } }[]} */
	const paths = [];

	for (const editoria of editorias) {
		const lista = await getPorEditoria(editoria.id as EditoriaId);
		const total = totalPaginas(lista.length);
		for (let pagina = 2; pagina <= total; pagina++) {
			paths.push({
				params: {
					editoria: editoria.id,
					pagina: String(pagina),
				},
				props: { editoria, pagina },
			});
		}
	}

	return paths;
}

interface Props {
	editoria: CollectionEntry<'editorias'>;
	pagina: number;
}

const { editoria, pagina } = Astro.props;
const editoriaId = editoria.id as EditoriaId;
const posts = await getPorEditoria(editoriaId);
const total = totalPaginas(posts.length);
const paginaItens = fatiaPagina(posts, pagina);
const nome = editoria.data.nome || nomeEditoria(editoriaId);
const baseUrl = `/${editoriaId}/`;

const autores = await Promise.all(
	paginaItens.map(async (item) => {
		const autor = await getEntry(item.entry.data.autor);
		return {
			key: `${item.kind}:${item.entry.id}`,
			nome: autor?.data.nome ?? 'Autor',
		};
	}),
);
const autorPorKey = Object.fromEntries(autores.map((a) => [a.key, a.nome]));

function propsCard(item: PostPorEditoria) {
	const key = `${item.kind}:${item.entry.id}`;
	const base = {
		titulo: item.entry.data.title,
		href: hrefPost(item),
		idPost: item.entry.id,
		description: item.entry.data.description,
		autorNome: autorPorKey[key] ?? 'Autor',
		pubDate: item.entry.data.pubDate,
		editoria: editoriaDePost(item),
		cover: item.entry.data.cover,
		coverAlt: item.entry.data.coverAlt,
		coverCredito: item.entry.data.coverCredito,
		coverLicencaUrl: item.entry.data.coverLicencaUrl,
	};
	if (item.kind === 'resenha') {
		return {
			...base,
			rotulo: 'Crítica',
			rotuloCapa: rotuloCapaResenha(item.entry.data),
			nota: item.entry.data.nota,
		};
	}
	return {
		...base,
		rotulo: nome,
		rotuloCapa: rotuloCapaArtigo(item.entry.data.editoria),
	};
}
---

<BaseLayout
	title={`${nome} – Página ${pagina}`}
	description={editoria.data.descricao}
>
	<section class="mx-auto max-w-6xl px-4 py-10 md:px-6">
		<Breadcrumb
			items={[
				{ label: 'Início', href: '/' },
				{ label: nome, href: baseUrl },
				{ label: `Página ${pagina}` },
			]}
		/>
		<h1 class="font-display text-4xl tracking-wide text-text md:text-5xl">
			{nome}
		</h1>
		<p class="mt-2 text-sm text-muted">Página {pagina}</p>
		<p class="mt-4 max-w-2xl text-muted">{editoria.data.descricao}</p>

		<div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
			{paginaItens.map((item) => <CardPost {...propsCard(item)} />)}
		</div>
		<Paginacao
			paginaAtual={pagina}
			totalPaginas={total}
			baseUrl={baseUrl}
		/>
	</section>
</BaseLayout>
