---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site, linkWhatsapp } from '../data/site';

const waHref = linkWhatsapp('Olá! Vim pelo site Arte Com Pipoca.');
---

<BaseLayout
	title="Contato"
	description="Fale com o Arte Com Pipoca: sugestões de pauta, correções e parcerias."
>
	<article class="mx-auto max-w-6xl px-4 py-10 md:px-6">
		<Breadcrumb
			items={[
				{ label: 'Início', href: '/' },
				{ label: 'Contato' },
			]}
		/>
		<h1 class="font-display text-4xl tracking-wide text-text md:text-5xl">
			Contato
		</h1>

		<div class="conteudo mt-10">
			<p>
				Sugestões de pauta, correções, dúvidas ou propostas de parceria: fale
				conosco pelo WhatsApp ou por e-mail. Respondemos quando pudermos, com
				atenção ao que você mandar.
			</p>
		</div>

		<div class="mt-10 flex flex-col gap-4">
			<a
				href={waHref}
				target="_blank"
				rel="noopener"
				class="inline-flex w-fit items-center gap-3 rounded bg-pipoca px-5 py-2.5 text-sm font-bold text-bg transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="currentColor"
					aria-hidden="true"
				>
					<path
						d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
					></path>
				</svg>
				<span>Falar no WhatsApp</span>
			</a>
			<p class="text-sm text-muted">
				WhatsApp:{' '}
				<a
					href={waHref}
					target="_blank"
					rel="noopener"
					class="text-pipoca underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca"
				>
					{site.whatsappExibicao}
				</a>
			</p>
			<p class="text-sm text-muted">
				E-mail:{' '}
				<a
					href={`mailto:${site.emailContato}`}
					class="text-pipoca underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca"
				>
					{site.emailContato}
				</a>
			</p>
		</div>
	</article>
</BaseLayout>
