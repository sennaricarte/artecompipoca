---
import '@fontsource/inter/400.css';
import '@fontsource/inter/700.css';
import '@fontsource/bebas-neue/400.css';
import bebasUrl from '@fontsource/bebas-neue/files/bebas-neue-latin-400-normal.woff2?url';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	canonical?: string;
	ogImage?: string;
	ogImageAlt?: string;
	ogType?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
	noindex?: boolean;
}

const {
	title,
	description,
	canonical,
	ogImage,
	ogImageAlt,
	ogType,
	publishedTime,
	modifiedTime,
	noindex,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0F0F12" />
		<link rel="icon" type="image/png" href="/logo-arte-com-pipoca.png" />
		<link rel="apple-touch-icon" href="/logo-arte-com-pipoca.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Arte Com Pipoca"
			href="/rss.xml"
		/>
		<link
			rel="preload"
			href={bebasUrl}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<SEO
			title={title}
			description={description}
			canonical={canonical}
			ogImage={ogImage}
			ogImageAlt={ogImageAlt}
			ogType={ogType}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			noindex={noindex}
		/>
		<slot name="head" />
	</head>
	<body class="flex min-h-dvh flex-col bg-bg font-body text-text antialiased">
		<a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
		<Header />
		<main id="conteudo" class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
