	<p class="compartilhar__feedback m-0 min-h-[1.25rem] text-xs text-pipoca" aria-live="polite">
	</p>

	{
		incluirScript && (
			<script is:inline>
				(function () {
					document.querySelectorAll('.compartilhar').forEach((root) => {
						const btn = root.querySelector('[data-copy-link]');
						const feedback = root.querySelector('.compartilhar__feedback');
						if (!btn || !feedback) return;
						btn.hidden = false;
						btn.addEventListener('click', async () => {
							const link = btn.getAttribute('data-url');
							if (!link) return;
							try {
								await navigator.clipboard.writeText(link);
								feedback.textContent = 'Link copiado!';
								setTimeout(() => {
									feedback.textContent = '';
								}, 2000);
							} catch {
								feedback.textContent = '';
							}
						});
					});
				})();
			</script>
		)
	}
</div>
