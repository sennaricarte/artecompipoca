---
interface Props {
	url: string;
	titulo: string;
	variant?: 'sidebar' | 'inline';
}

const { url, titulo, variant = 'inline' } = Astro.props;

const whatsappUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(`${titulo} ${url}`)}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(titulo)}&url=${encodeURIComponent(url)}`;
const threadsUrl = `https://www.threads.net/intent/post?text=${encodeURIComponent(`${titulo} ${url}`)}`;
const telegramUrl = `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(titulo)}`;
const mailUrl = `mailto:?subject=${encodeURIComponent(titulo)}&body=${encodeURIComponent(url)}`;

import { site } from '../data/site';

const redes = [
	{ id: 'whatsapp', label: 'WhatsApp', href: whatsappUrl },
	{ id: 'facebook', label: 'Facebook', href: facebookUrl },
	{ id: 'x', label: 'X', href: xUrl },
	{ id: 'threads', label: 'Threads', href: threadsUrl },
	{ id: 'telegram', label: 'Telegram', href: telegramUrl },
	{ id: 'email', label: 'E-mail', href: mailUrl },
	// Instagram: convite a seguir o perfil (não é um compartilhamento de URL)
	{ id: 'instagram', label: 'Instagram', href: site.instagram, follow: true },
];

const btnClass =
	'compartilhar__btn inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface text-text transition-colors hover:bg-pipoca hover:text-bg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca';

const threadsPath =
	'M18.263 11.097c-.03-3.486-1.92-5.586-5.111-5.586-2.13 0-3.922.963-4.863 2.499l2.062 1.438c.535-.843 1.272-1.543 2.628-1.543 1.528 0 2.318.85 2.544 2.431a15 15 0 0 0-2.236-.173c-4.125 0-6.068 1.867-6.068 4.336s1.943 3.99 4.804 3.99c3.139 0 5.013-2.115 5.781-4.735.798.361 1.348 1.204 1.348 2.47 0 3.387-3.907 5.232-7.22 5.232-4.885 0-8.077-3.207-8.077-8.424 0-6.392 4.223-10.487 9.9-10.487 3.808 0 5.69 1.671 6.97 3.914l2.108-1.475C21.44 2.078 18.331 0 13.663 0 6.227 0 1.168 5.277 1.168 12.934c0 7 4.953 11.066 10.856 11.066 4.878 0 9.809-2.846 9.809-7.716 0-2.545-1.46-4.231-3.569-5.187m-6.33 4.855c-1.077 0-2.026-.512-2.026-1.453 0-1.483 1.822-1.934 3.606-1.934.678 0 1.34.045 1.927.173-.422 1.927-1.671 3.215-3.508 3.214Z';
---

<div
	class:list={[
		'compartilhar',
		variant === 'sidebar'
			? 'compartilhar--sidebar'
			: 'compartilhar--inline flex flex-col gap-2',
	]}
>
	{
		variant === 'sidebar' ? (
			<p class="compartilhar__rotulo m-0 text-xs font-medium tracking-wide text-muted">
				Compartilhar
			</p>
		) : (
			<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
				<p class="compartilhar__rotulo m-0 shrink-0 text-sm font-medium text-muted">
					Compartilhe:
				</p>
				<nav class="compartilhar__nav flex flex-wrap gap-2" aria-label="Compartilhar este texto">
					{redes.map((rede) => (
						<a
							href={rede.href}
							class={btnClass}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={rede.id === 'instagram' ? 'Seguir no Instagram' : `Compartilhar no ${rede.label}`}
							title={rede.label}
						>
							<svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
								{rede.id === 'whatsapp' && (
									<path
										fill="currentColor"
										d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.884 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
									/>
								)}
					{rede.id === 'facebook' && (
									<path
										fill="currentColor"
										d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
									/>
								)}
								{rede.id === 'instagram' && (
									<>
										<rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="0" fill="currentColor" />
										<circle cx="12" cy="12" r="4" fill="white" />
										<circle cx="17.5" cy="6.5" r="0.9" fill="white" />
									</>
								)}
								{rede.id === 'x' && (
									<path
										fill="currentColor"
										d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932 6.064-6.932zm-1.291 19.497h2.039L6.486 3.24H4.298l13.312 17.41z"
									/>
								)}
								{rede.id === 'threads' && (
									<path fill="currentColor" d={threadsPath} />
								)}
								{rede.id === 'telegram' && (
									<path
										fill="currentColor"
										d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
									/>
								)}
								{rede.id === 'email' && (
									<path
										fill="currentColor"
										d="M20 4H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"
									/>
								)}
							</svg>
						</a>
					))}
					<button
						type="button"
						class={btnClass}
						data-copy-link
						data-url={url}
						hidden
						aria-label="Copiar link"
						title="Copiar link"
					>
						<svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
							<path
								fill="currentColor"
								d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
							/>
						</svg>
					</button>
				</nav>
				<p class="compartilhar__feedback m-0 min-h-[1.25rem] text-xs text-pipoca" aria-live="polite">
				</p>
			</div>
		)
	}

	{
		variant === 'sidebar' && (
			<nav class="compartilhar__nav mt-3 flex flex-col gap-2" aria-label="Compartilhar este texto">
				{redes.map((rede) => (
					<a
						href={rede.href}
						class={btnClass}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={rede.id === 'instagram' ? 'Seguir no Instagram' : `Compartilhar no ${rede.label}`}
						title={rede.label}
					>
						<svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
							{rede.id === 'whatsapp' && (
								<path
									fill="currentColor"
									d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.884 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
								/>
							)}
							{rede.id === 'facebook' && (
								<path
									fill="currentColor"
									d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
								/>
							)}
							{rede.id === 'instagram' && (
								<>
									<rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="0" fill="currentColor" />
									<circle cx="12" cy="12" r="4" fill="white" />
									<circle cx="17.5" cy="6.5" r="0.9" fill="white" />
								</>
							)}
							{rede.id === 'x' && (
								<path
									fill="currentColor"
									d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932 6.064-6.932zm-1.291 19.497h2.039L6.486 3.24H4.298l13.312 17.41z"
								/>
							)}
							{rede.id === 'threads' && (
								<path fill="currentColor" d={threadsPath} />
							)}
							{rede.id === 'telegram' && (
								<path
									fill="currentColor"
									d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
								/>
							)}
							{rede.id === 'email' && (
								<path
									fill="currentColor"
									d="M20 4H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"
								/>
							)}
						</svg>
					</a>
				))}
				<button
					type="button"
					class={btnClass}
					data-copy-link
					data-url={url}
					hidden
					aria-label="Copiar link"
					title="Copiar link"
				>
					<svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
						<path
							fill="currentColor"
							d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
						/>
					</svg>
				</button>
			</nav>
		)
	}

	{
		variant === 'sidebar' && (
			<p class="compartilhar__feedback m-0 min-h-[1.25rem] text-xs text-pipoca" aria-live="polite">
			</p>
		)
	}

	{
		variant === 'sidebar' && (
			<script is:inline>
				(function () {
					function initCompartilhar() {
						document.querySelectorAll('.compartilhar').forEach((root) => {
							if (root.dataset.copyReady === 'true') return;
							const btn = root.querySelector('[data-copy-link]');
							const feedback = root.querySelector('.compartilhar__feedback');
							if (!btn || !feedback) return;
							root.dataset.copyReady = 'true';
							btn.hidden = false;
							btn.removeAttribute('hidden');
							btn.addEventListener('click', async () => {
								const link = btn.getAttribute('data-url');
								if (!link) return;
								try {
									await navigator.clipboard.writeText(link);
									feedback.textContent = 'Link copiado!';
									setTimeout(() => {
										feedback.textContent = '';
									}, 2000);
								} catch {
									feedback.textContent = '';
								}
							});
						});
					}
					if (document.readyState === 'loading') {
						document.addEventListener('DOMContentLoaded', initCompartilhar);
					} else {
						initCompartilhar();
					}
				})();
			</script>
		)
	}
</div>
