							</svg>
						</a>
					))}
					<button
						type="button"
						class={btnClass}
						data-copy-link
						data-url={url}
						hidden
						aria-label="Copiar link"
						title="Copiar link"
					>
						<svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
							<path
								fill="currentColor"
								d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
							/>
						</svg>
					</button>
				</nav>
			</div>
		)
	}

	{
		variant === 'sidebar' && (
			<nav class="compartilhar__nav mt-3 flex flex-col gap-2" aria-label="Compartilhar este texto">
				{redes.map((rede) => (
					<a
						href={rede.href}
						class={btnClass}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`Compartilhar no ${rede.label}`}
						title={rede.label}
					>
						<svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
							{rede.id === 'whatsapp' && (
