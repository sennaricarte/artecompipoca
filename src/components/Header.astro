---
import Logo from './Logo.astro';
import SearchForm from './SearchForm.astro';
import { NAV_EDITORIAS } from '../lib/conteudo';

const navItems = [
	...NAV_EDITORIAS.map((item) => ({ href: item.href, label: item.label })),
	{ href: '/resenhas/', label: 'Resenhas' },
] as const;

const pathname = Astro.url.pathname.endsWith('/')
	? Astro.url.pathname
	: `${Astro.url.pathname}/`;

function isActive(href: string) {
	return pathname === href;
}
---

<header
	class="sticky top-0 z-50 border-b border-white/10 bg-surface"
>
	<div class="relative mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
		<a
			href="/"
			class="inline-flex shrink-0 items-center rounded-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca"
			aria-label="Arte Com Pipoca — início"
		>
			<Logo width={96} class="h-16 w-16 md:h-24 md:w-24" loading="eager" />
		</a>

		<input
			type="checkbox"
			id="nav-toggle"
			class="peer sr-only"
		/>
		<label
			for="nav-toggle"
			class="inline-flex cursor-pointer items-center justify-center rounded p-2 text-text hover:text-pipoca focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca md:hidden"
			aria-label="Abrir menu"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</label>

		<nav
			aria-label="Principal"
			class="absolute left-0 right-0 top-full z-50 hidden flex-col gap-1 border-b border-white/10 bg-surface px-4 py-3 peer-checked:flex md:static md:flex md:flex-row md:items-center md:gap-2.5 md:border-0 md:bg-transparent md:p-0 lg:gap-4 xl:gap-6"
		>
			{
				navItems.map((item) => (
					<a
						href={item.href}
						aria-current={isActive(item.href) ? 'page' : undefined}
						class:list={[
							'whitespace-nowrap rounded px-1.5 py-2 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca md:px-2 md:py-1 md:text-[0.8125rem] lg:text-sm',
							isActive(item.href)
								? 'text-pipoca'
								: 'text-muted hover:text-text',
						]}
					>
						{item.label}
					</a>
				))
			}
			<div class="mt-2 border-t border-white/10 pt-3 md:mt-0 md:ml-2 md:border-0 md:pt-0">
				<SearchForm id="busca-header" compact />
			</div>
		</nav>
	</div>
</header>
