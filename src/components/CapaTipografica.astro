---
import { TEMAS_CAPA } from '../lib/capas';
import type { EditoriaId } from '../lib/conteudo';

interface Props {
	titulo: string;
	rotulo: string;
	editoria: EditoriaId;
	nota?: number;
	class?: string;
}

const { titulo, rotulo, editoria, nota, class: className } = Astro.props;

const tema = TEMAS_CAPA[editoria];
const notaLabel =
	nota != null
		? Number.isInteger(nota)
			? `${nota}/10`
			: `${nota}/10`
		: null;
---

{/* aria-hidden: o título já está no card / h1 da página */}
<div
	class:list={['capa-tipografica relative w-full overflow-hidden', className]}
	style={`aspect-ratio: 16 / 9; background: ${tema.fundo}; color: ${tema.texto};`}
	aria-hidden="true"
>
	{/* Textura sutil só com CSS */}
	<div
		class="capa-tipografica__textura pointer-events-none absolute inset-0"
		aria-hidden="true"
	></div>

	<div class="relative z-10 flex h-full flex-col justify-end p-4 md:p-6">
		<p
			class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] md:text-xs"
			style={`color: ${tema.rotulo};`}
		>
			{rotulo}
		</p>
		<p
			class="mt-2 font-display text-2xl leading-none tracking-wide md:text-4xl lg:text-5xl"
			style={`color: ${tema.texto};`}
		>
			{titulo}
		</p>
	</div>

	{
		notaLabel != null && (
			<span
				class="absolute right-3 top-3 z-10 flex h-12 w-12 items-center justify-center rounded-full font-display text-sm tracking-wide md:right-4 md:top-4 md:h-14 md:w-14 md:text-base"
				style={`background: ${tema.seloBg}; color: ${tema.seloTexto};`}
			>
				{notaLabel}
			</span>
		)
	}
</div>

<style>
	.capa-tipografica__textura {
		opacity: 0.35;
		background-image:
			repeating-linear-gradient(
				-18deg,
				transparent,
				transparent 11px,
				rgba(255, 255, 255, 0.04) 11px,
				rgba(255, 255, 255, 0.04) 12px
			),
			radial-gradient(
				circle at 1px 1px,
				rgba(0, 0, 0, 0.12) 1px,
				transparent 0
			);
		background-size:
			auto,
			10px 10px;
	}
</style>
