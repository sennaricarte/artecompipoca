---
import { rotuloEditoriasSite } from '../lib/conteudo';

interface Props {
	title: string;
	description: string;
	canonical?: string;
	ogImage?: string;
	ogImageAlt?: string;
	ogType?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
	noindex?: boolean;
}

const {
	title,
	description,
	ogImage = '/og/padrao.png',
	ogImageAlt = Astro.props.ogImage
		? title
		: `Arte Com Pipoca: ${rotuloEditoriasSite()} desde 2013`,
	ogType = 'website',
	publishedTime,
	modifiedTime,
	noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://artecompipoca.net');

const pathWithSlash = Astro.url.pathname.endsWith('/')
	? Astro.url.pathname
	: `${Astro.url.pathname}/`;
const defaultCanonical = new URL(pathWithSlash, site).href;
const canonical = Astro.props.canonical
	? new URL(Astro.props.canonical, site).href
	: defaultCanonical;

const pageTitle = title === 'Arte Com Pipoca' ? title : `${title} | Arte Com Pipoca`;
const robots = noindex ? 'noindex,follow' : 'index,follow';
const ogImageAbsolute = new URL(ogImage, site).href;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
<meta name="robots" content={robots} />

<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageAbsolute} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Arte Com Pipoca" />
<meta property="og:locale" content="pt_BR" />
{ogType === 'article' && publishedTime && (
	<meta property="article:published_time" content={publishedTime} />
)}
{ogType === 'article' && modifiedTime && (
	<meta property="article:modified_time" content={modifiedTime} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbsolute} />
<meta name="twitter:image:alt" content={ogImageAlt} />
