---
import Logo from './Logo.astro';
import { rotuloEditoriasSite } from '../lib/conteudo';
import { site } from '../data/site';

const year = new Date().getFullYear();

const links = [
	{ href: '/sobre/', label: 'Sobre' },
	{ href: '/autores/', label: 'Nossa equipe' },
	{ href: '/politica-editorial/', label: 'Política editorial' },
	{ href: '/contato/', label: 'Contato' },
	{ href: '/politica-de-privacidade/', label: 'Política de privacidade' },
	{ href: '/rss.xml', label: 'RSS' },
] as const;
---

<footer class="mt-auto border-t border-white/10 bg-surface">
	<div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 md:px-6">
		<div class="flex flex-col gap-2">
			<a
				href="/"
				class="inline-flex w-fit items-center rounded-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca"
				aria-label="Arte Com Pipoca — início"
			>
				<Logo width={96} class="h-20 w-20 md:h-24 md:w-24" />
			</a>
			<p class="max-w-md text-sm text-muted">
				{rotuloEditoriasSite()} desde 2013
			</p>
		</div>

		
		<div class="flex items-center gap-4">
			<nav aria-label="Rodapé" class="flex flex-wrap gap-x-6 gap-y-2">
				{
					links.map((link) => (
						<a
							href={link.href}
							class="text-sm text-muted transition-colors hover:text-pipoca focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca"
						>
							{link.label}
						</a>
					))
				}
			</nav>

			<div class="flex gap-3 items-center">
				<a
					href={site.instagram}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Arte Com Pipoca no Instagram"
					class="text-muted transition-colors hover:text-pipoca"
				>
					<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.2" />
						<circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.2" fill="none" />
						<circle cx="17.5" cy="6.5" r="0.7" fill="currentColor" />
					</svg>
				</a>
				<a
					href={site.facebook}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Arte Com Pipoca no Facebook"
					class="text-muted transition-colors hover:text-pipoca"
				>
					<svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
						<path
							fill="currentColor"
							d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
						/>
					</svg>
				</a>
			</div>
		</div>

		<p class="text-sm text-muted">© {year} Arte Com Pipoca</p>
	</div>
</footer>
