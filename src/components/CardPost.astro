---
import type { ImageMetadata } from 'astro';
import { capaDoPost } from '../lib/capas';
import { formatarData, type EditoriaId } from '../lib/conteudo';
import CapaPost from './CapaPost.astro';
import CapaTipografica from './CapaTipografica.astro';

interface Props {
	titulo: string;
	href: string;
	/** Id do post (entry.id): define a variante de cor da capa. */
	idPost: string;
	description: string;
	autorNome: string;
	pubDate: Date;
	rotulo: string;
	/** Editoria visual da capa tipográfica / contexto. */
	editoria: EditoriaId;
	/** Rótulo da capa (ex.: "Crítica · Filme · 1974"). */
	rotuloCapa?: string;
	nota?: number;
	cover?: ImageMetadata;
	coverAlt?: string;
	coverCredito?: string;
	coverLicencaUrl?: string;
	coverPosicao?: string;
	capaPrioridade?: boolean;
	nivelTitulo?: 'h2' | 'h3';
	/** Cards um pouco maiores (home / destaques). */
	destaque?: boolean;
	/** Primeiro destaque: ocupa 2 colunas a partir de lg, em 21:9. */
	largo?: boolean;
	capaSizes?: string;
	class?: string;
}

const {
	titulo,
	href,
	idPost,
	description,
	autorNome,
	pubDate,
	rotulo,
	editoria,
	rotuloCapa,
	nota,
	cover,
	coverAlt,
	coverCredito,
	coverLicencaUrl,
	coverPosicao,
	capaPrioridade = false,
	nivelTitulo = 'h2',
	destaque = false,
	largo = false,
	capaSizes,
	class: className,
} = Astro.props;

const Titulo = nivelTitulo;
const temCover = Boolean(cover && coverAlt);
const tema = capaDoPost(editoria, idPost);
const proporcaoClass = largo ? 'aspect-video lg:aspect-[21/9]' : 'aspect-video';

// O link do título cobre a capa inteira (after:inset-0): um único link por card.
const linkBase =
	'after:absolute after:inset-0 after:rounded-sm focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-pipoca';

const tituloSobreCapaClass = [
	'font-display leading-[0.95] tracking-wide',
	largo
		? 'text-3xl md:text-4xl lg:text-6xl'
		: destaque
			? 'text-3xl md:text-4xl'
			: 'text-2xl md:text-3xl',
];
const tituloAbaixoClass = [
	'mt-4 font-display tracking-wide text-text',
	destaque ? 'text-3xl md:text-4xl' : 'text-2xl md:text-3xl',
];
const sizesPadrao = largo
	? '(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 1100px'
	: '(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 380px';
---

<article class:list={['relative flex flex-col', className]}>
	{
		temCover ? (
			<>
				<CapaPost
					editoria={editoria}
					idPost={idPost}
					rotulo={rotuloCapa ?? rotulo}
					nota={nota}
					cover={cover}
					coverAlt={coverAlt}
					coverCredito={coverCredito}
					coverLicencaUrl={coverLicencaUrl}
					coverPosicao={coverPosicao}
					contexto="card"
					prioridade={capaPrioridade}
					sizes={capaSizes ?? sizesPadrao}
					widths={largo ? [400, 800, 1200] : [400, 800]}
					proporcaoClass={proporcaoClass}
					class="rounded-sm"
				/>
				<Titulo class:list={tituloAbaixoClass}>
					<a
						href={href}
						class={`${linkBase} transition-colors hover:text-pipoca`}
					>
						{titulo}
					</a>
				</Titulo>
			</>
		) : (
			<CapaTipografica
				editoria={editoria}
				idPost={idPost}
				rotulo={rotuloCapa ?? rotulo}
				nota={nota}
				proporcaoClass={proporcaoClass}
				decorativa={false}
				class="rounded-sm"
			>
				<Titulo class:list={tituloSobreCapaClass} style={`color: ${tema.texto};`}>
					<a
						href={href}
						class={`${linkBase} decoration-2 underline-offset-4 hover:underline`}
					>
						{titulo}
					</a>
				</Titulo>
			</CapaTipografica>
		)
	}
	<p
		class:list={[
			'line-clamp-3 max-w-3xl text-muted',
			destaque && largo ? 'mt-3 text-base leading-relaxed md:text-lg' : 'mt-3 text-base',
		]}
	>
		{description}
	</p>
	<p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
		<span>{autorNome}</span>
		<span aria-hidden="true">·</span>
		<time datetime={pubDate.toISOString()}>{formatarData(pubDate)}</time>
		{
			temCover && (
				<>
					<span aria-hidden="true">·</span>
					<span class="text-pipoca">{rotulo}</span>
					{nota != null && (
						<>
							<span aria-hidden="true">·</span>
							<span>Nota: {nota}/10</span>
						</>
					)}
				</>
			)
		}
	</p>
</article>
