---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { capaDoPost } from '../lib/capas';
import type { EditoriaId } from '../lib/conteudo';
import CapaTipografica from './CapaTipografica.astro';

interface Props {
	editoria: EditoriaId;
	/** Id do post: variante de cor da capa tipográfica e do fundo do cartaz vertical. */
	idPost: string;
	rotulo: string;
	nota?: number;
	cover?: ImageMetadata;
	coverAlt?: string;
	coverCredito?: string;
	/** Link da licença (CC BY / BY-SA exigem atribuição com link). */
	coverLicencaUrl?: string;
	/** Eager + fetchpriority high (LCP). Só faz diferença com cover real. */
	prioridade?: boolean;
	sizes?: string;
	widths?: number[];
	/** Proporção da moldura da imagem. */
	proporcaoClass?: string;
	/** Proporção da faixa tipográfica quando não há cover (título fica no h1). */
	proporcaoSemCoverClass?: string;
	/** Classes extras da moldura (ex.: altura máxima na página interna). */
	molduraClass?: string;
	class?: string;
}

const {
	editoria,
	idPost,
	rotulo,
	nota,
	cover,
	coverAlt,
	coverCredito,
	coverLicencaUrl,
	prioridade = false,
	sizes = '(max-width: 768px) 100vw, 800px',
	widths = [400, 800],
	proporcaoClass = 'aspect-video',
	proporcaoSemCoverClass = 'aspect-[4/1]',
	molduraClass,
	class: className,
} = Astro.props;

const temCover = Boolean(cover && coverAlt);
const vertical = cover ? cover.height > cover.width : false;
// Com width e height juntos o sharp recorta (fit cover); no vertical manter a proporção natural.
const larguraImg = Math.max(...widths);
const alturaImg =
	cover && vertical
		? Math.round((larguraImg * cover.height) / cover.width)
		: Math.round((larguraImg * 9) / 16);
---

{
	temCover && cover && coverAlt ? (
		<figure
			class:list={['capa-post relative m-0 w-full overflow-hidden', className]}
		>
			<div
				class:list={[
					'w-full overflow-hidden',
					proporcaoClass,
					vertical ? null : 'bg-surface',
					molduraClass,
				]}
				style={vertical ? `background: ${capaDoPost(editoria, idPost).fundo};` : undefined}
			>
				<Picture
					src={cover}
					formats={['avif', 'webp']}
					widths={widths}
					sizes={sizes}
					width={larguraImg}
					height={alturaImg}
					alt={coverAlt}
					loading={prioridade ? 'eager' : 'lazy'}
					fetchpriority={prioridade ? 'high' : undefined}
					quality="mid"
					pictureAttributes={{ class: 'block h-full w-full' }}
					class:list={[
						'h-full w-full',
						vertical ? 'object-contain' : 'object-cover',
					]}
				/>
			</div>
			{coverCredito &&
				(coverLicencaUrl ? (
					<small class="absolute bottom-2 right-2 z-10 max-w-[85%] rounded-sm bg-black/70 px-2 py-1 text-[0.65rem] leading-tight text-white/90 md:text-xs">
						<a
							href={coverLicencaUrl}
							rel="noopener nofollow"
							target="_blank"
							class="underline decoration-white/50 underline-offset-2 hover:text-white hover:decoration-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca"
						>
							{coverCredito}
						</a>
					</small>
				) : (
					<small class="pointer-events-none absolute bottom-2 right-2 z-10 max-w-[85%] rounded-sm bg-black/70 px-2 py-1 text-[0.65rem] leading-tight text-white/90 md:text-xs">
						{coverCredito}
					</small>
				))}
		</figure>
	) : (
		<CapaTipografica
			editoria={editoria}
			idPost={idPost}
			rotulo={rotulo}
			nota={nota}
			proporcaoClass={proporcaoSemCoverClass}
			class={className}
		/>
	)
}
