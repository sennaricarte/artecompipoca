---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { EditoriaId } from '../lib/conteudo';
import CapaTipografica from './CapaTipografica.astro';

interface Props {
	editoria: EditoriaId;
	/** Id do post: variante de cor da capa tipográfica. */
	idPost: string;
	rotulo: string;
	nota?: number;
	/** Cena horizontal; preenche a moldura com object-fit: cover. */
	cover?: ImageMetadata;
	coverAlt?: string;
	coverCredito?: string;
	/** Link da licença (CC BY / BY-SA exigem atribuição com link). */
	coverLicencaUrl?: string;
	/** object-position da cena (padrão "center"). */
	coverPosicao?: string;
	/**
	 * card: crédito só quando há licença, em linha abaixo da imagem.
	 * post: crédito sempre em figcaption abaixo da imagem.
	 */
	contexto?: 'card' | 'post';
	/** Eager + fetchpriority high (LCP). Só faz diferença com cover real. */
	prioridade?: boolean;
	sizes?: string;
	widths?: number[];
	/** Proporção da moldura da imagem. */
	proporcaoClass?: string;
	/** Proporção da faixa tipográfica quando não há cover (título fica no h1). */
	proporcaoSemCoverClass?: string;
	/** Classes extras da moldura (ex.: altura máxima na página interna). */
	molduraClass?: string;
	class?: string;
}

const {
	editoria,
	idPost,
	rotulo,
	nota,
	cover,
	coverAlt,
	coverCredito,
	coverLicencaUrl,
	coverPosicao,
	contexto = 'post',
	prioridade = false,
	sizes = '(max-width: 768px) 100vw, 800px',
	widths = [400, 800],
	proporcaoClass = 'aspect-video',
	proporcaoSemCoverClass = 'aspect-[4/1]',
	molduraClass,
	class: className,
} = Astro.props;

const temCover = Boolean(cover && coverAlt);
// Altura na proporção real: o recorte fica com o CSS (object-position), não com o sharp.
const larguraImg = Math.max(...widths);
const alturaImg = cover ? Math.round((larguraImg * cover.height) / cover.width) : 0;
const mostrarCredito =
	Boolean(coverCredito) && (contexto === 'post' || Boolean(coverLicencaUrl));
const linkCreditoClass =
	'underline decoration-muted/50 underline-offset-2 hover:text-text hover:decoration-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca';
---

{
	temCover && cover && coverAlt ? (
		<figure class:list={['capa-post m-0 w-full', className]}>
			<div
				class:list={[
					'w-full overflow-hidden rounded-[inherit] bg-surface',
					proporcaoClass,
					molduraClass,
				]}
			>
				<Picture
					src={cover}
					formats={['avif', 'webp']}
					widths={widths}
					sizes={sizes}
					width={larguraImg}
					height={alturaImg}
					alt={coverAlt}
					loading={prioridade ? 'eager' : 'lazy'}
					fetchpriority={prioridade ? 'high' : undefined}
					quality="mid"
					pictureAttributes={{ class: 'block h-full w-full' }}
					class="h-full w-full object-cover"
					style={`object-position: ${coverPosicao ?? 'center'};`}
				/>
			</div>
			{mostrarCredito && (
				<figcaption
					class:list={[
						'mt-1.5 text-xs leading-snug text-muted',
						contexto === 'card' ? 'relative z-10' : null,
					]}
				>
					{coverLicencaUrl ? (
						<a
							href={coverLicencaUrl}
							rel="noopener nofollow"
							target="_blank"
							class={linkCreditoClass}
						>
							{coverCredito}
						</a>
					) : (
						coverCredito
					)}
				</figcaption>
			)}
		</figure>
	) : (
		<CapaTipografica
			editoria={editoria}
			idPost={idPost}
			rotulo={rotulo}
			nota={nota}
			proporcaoClass={proporcaoSemCoverClass}
			class={className}
		/>
	)
}
