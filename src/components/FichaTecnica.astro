---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Fonte {
	nome: string;
	url: string;
}

interface Ficha {
	tituloOriginal?: string;
	ano?: number;
	direcao?: string[];
	roteiro?: string[];
	elenco?: string[];
	generos?: string[];
	duracaoMin?: number;
	paises?: string[];
	criadores?: string[];
	temporadas?: number;
	emissora?: string;
	wikidataId?: string;
	sinopse?: string;
	curiosidades?: string[];
	premios?: string[];
	trailerYoutubeId?: string;
	fontes?: Fonte[];
}

interface Props {
	ficha?: Ficha;
	obra: string;
	tipo: 'filme' | 'serie' | 'hq' | 'album';
	/** inicio = sinopse/trailer; fim = ficha técnica e blocos finais */
	parte: 'inicio' | 'fim';
	/** Cartaz vertical exibido ao lado da lista da ficha técnica. */
	cartaz?: ImageMetadata;
	cartazAlt?: string;
	cartazCredito?: string;
	/** Só curiosidades, prêmios, onde assistir e fontes (ficha já exibida no corpo). */
	somenteAuxiliares?: boolean;
}

const {
	ficha = {},
	obra,
	tipo,
	parte,
	cartaz,
	cartazAlt,
	cartazCredito,
	somenteAuxiliares = false,
} = Astro.props;

const CARTAZ_LARGURA = 180;
const temCartaz = Boolean(cartaz && cartazAlt);
const cartazAltura = cartaz
	? Math.round((CARTAZ_LARGURA * cartaz.height) / cartaz.width)
	: 0;

/**
 * @param {number} min
 * @returns {string}
 */
function formatarDuracao(min: number): string {
	const h = Math.floor(min / 60);
	const m = min % 60;
	if (h <= 0) return `${m}min`;
	if (m <= 0) return `${h}h`;
	return `${h}h ${m}min`;
}

/** @param {string[] | undefined} list */
function juntar(list: string[] | undefined): string | undefined {
	if (!list?.length) return undefined;
	return list.join(', ');
}

const campos: { rotulo: string; valor: string }[] = [];

if (ficha.tituloOriginal) {
	campos.push({ rotulo: 'Título original', valor: ficha.tituloOriginal });
}
if (ficha.ano != null) {
	campos.push({ rotulo: 'Ano', valor: String(ficha.ano) });
}
if (juntar(ficha.direcao)) {
	campos.push({ rotulo: 'Direção', valor: juntar(ficha.direcao)! });
}
if (juntar(ficha.criadores)) {
	campos.push({ rotulo: 'Criação', valor: juntar(ficha.criadores)! });
}
if (juntar(ficha.roteiro)) {
	campos.push({ rotulo: 'Roteiro', valor: juntar(ficha.roteiro)! });
}
if (juntar(ficha.elenco)) {
	campos.push({ rotulo: 'Elenco', valor: juntar(ficha.elenco)! });
}
if (juntar(ficha.generos)) {
	campos.push({ rotulo: 'Gênero', valor: juntar(ficha.generos)! });
}
if (ficha.duracaoMin != null) {
	campos.push({ rotulo: 'Duração', valor: formatarDuracao(ficha.duracaoMin) });
}
if (ficha.temporadas != null) {
	campos.push({ rotulo: 'Temporadas', valor: String(ficha.temporadas) });
}
if (ficha.emissora) {
	campos.push({ rotulo: 'Emissora', valor: ficha.emissora });
}
if (juntar(ficha.paises)) {
	campos.push({ rotulo: 'País', valor: juntar(ficha.paises)! });
}

const temSinopse = Boolean(ficha.sinopse?.trim());
const temTrailer = Boolean(ficha.trailerYoutubeId);
const temCampos = campos.length > 0;
const temPremios = Boolean(ficha.premios?.length);
const temCuriosidades = Boolean(ficha.curiosidades?.length);
const temFontes = Boolean(ficha.fontes?.length);
const mostrarOndeAssistir = tipo === 'filme' || tipo === 'serie';
const justWatchUrl = `https://www.justwatch.com/br/busca?q=${encodeURIComponent(obra)}`;
const trailerId = ficha.trailerYoutubeId ?? '';
const trailerWatchUrl = trailerId
	? `https://www.youtube.com/watch?v=${trailerId}`
	: '';
const trailerThumb = trailerId
	? `https://i.ytimg.com/vi_webp/${trailerId}/hqdefault.webp`
	: '';
---

{
	parte === 'inicio' && (
		<>
			{temSinopse && (
				<section class="mt-10" aria-labelledby="sinopse-titulo">
					<h2
						id="sinopse-titulo"
						class="font-display text-2xl tracking-wide text-pipoca"
					>
						Sinopse
					</h2>
					<p class="mt-3 text-base leading-relaxed text-text md:text-lg">
						{ficha.sinopse}
					</p>
				</section>
			)}

			{temTrailer && (
				<section class="mt-10" aria-labelledby="trailer-titulo">
					<h2
						id="trailer-titulo"
						class="font-display text-2xl tracking-wide text-pipoca"
					>
						Trailer
					</h2>
					<div class="relative mt-4 aspect-video w-full max-w-3xl overflow-hidden rounded-sm bg-black">
						{/*
							Com JS: botão troca-se por iframe no clique.
							Sem JS: o noscript expõe o mesmo visual como link para o YouTube.
						*/}
						<button
							type="button"
							class="group absolute inset-0 block h-full w-full cursor-pointer border-0 bg-transparent p-0"
							data-yt-trailer={trailerId}
							aria-label={`Assistir ao trailer de ${obra}`}
						>
							<img
								src={trailerThumb}
								alt={`Trailer de ${obra}`}
								width="480"
								height="360"
								loading="lazy"
								decoding="async"
								class="h-full w-full object-cover"
							/>
							<span
								class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/35 transition-colors group-hover:bg-black/45"
								aria-hidden="true"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="68"
									height="68"
									viewBox="0 0 68 68"
									fill="none"
								>
									<circle cx="34" cy="34" r="34" fill="#FFC83D"></circle>
									<path d="M28 22v24l22-12-22-12z" fill="#0F0F12"></path>
								</svg>
							</span>
						</button>
						<noscript>
							<style>
								[data-yt-trailer] {
									display: none !important;
								}
							</style>
							<a
								href={trailerWatchUrl}
								class="group absolute inset-0 block h-full w-full"
								aria-label={`Assistir ao trailer de ${obra}`}
								rel="noopener"
								target="_blank"
							>
								<img
									src={trailerThumb}
									alt={`Trailer de ${obra}`}
									width="480"
									height="360"
									loading="lazy"
									decoding="async"
									class="h-full w-full object-cover"
								/>
								<span
									class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/35"
									aria-hidden="true"
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="68"
										height="68"
										viewBox="0 0 68 68"
										fill="none"
									>
										<circle cx="34" cy="34" r="34" fill="#FFC83D"></circle>
										<path d="M28 22v24l22-12-22-12z" fill="#0F0F12"></path>
									</svg>
								</span>
							</a>
						</noscript>
					</div>
				</section>
			)}
		</>
	)
}

{
	parte === 'fim' && (
		<>
			{!somenteAuxiliares && (temCampos || temCartaz) && (
				<section
					class="mt-12 rounded-sm border border-white/10 bg-surface px-4 py-6 md:px-6"
					aria-labelledby="ficha-titulo"
				>
					<h2
						id="ficha-titulo"
						class="font-display text-2xl tracking-wide text-pipoca"
					>
						Ficha técnica
					</h2>
					{temCartaz && cartaz && cartazAlt ? (
						<div class="mt-4 flex flex-col items-center gap-6 md:flex-row md:items-start">
							<figure class="m-0 w-40 shrink-0 md:w-[180px]">
								<Picture
									src={cartaz}
									formats={['avif', 'webp']}
									widths={[160, 180, 320, 360]}
									sizes="(min-width: 768px) 180px, 160px"
									width={CARTAZ_LARGURA}
									height={cartazAltura}
									alt={cartazAlt}
									loading="lazy"
									quality="mid"
									pictureAttributes={{ class: 'block' }}
									class="h-auto w-full rounded-sm"
								/>
								{cartazCredito && (
									<figcaption class="mt-1.5 text-xs leading-snug text-muted">
										{cartazCredito}
									</figcaption>
								)}
							</figure>
							{temCampos && (
								<dl class="grid w-full min-w-0 flex-1 grid-cols-1 gap-x-8 gap-y-3 text-sm md:grid-cols-2">
									{campos.map((campo) => (
										<div>
											<dt class="text-muted">{campo.rotulo}</dt>
											<dd class="font-medium text-text">{campo.valor}</dd>
										</div>
									))}
								</dl>
							)}
						</div>
					) : (
						<dl class="mt-4 grid grid-cols-1 gap-x-8 gap-y-3 text-sm md:grid-cols-2">
							{campos.map((campo) => (
								<div>
									<dt class="text-muted">{campo.rotulo}</dt>
									<dd class="font-medium text-text">{campo.valor}</dd>
								</div>
							))}
						</dl>
					)}
				</section>
			)}

			{temPremios && (
				<section class="mt-12" aria-labelledby="premios-titulo">
					<h2
						id="premios-titulo"
						class="font-display text-2xl tracking-wide text-pipoca"
					>
						Prêmios
					</h2>
					<ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-text md:text-base">
						{ficha.premios!.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</section>
			)}

			{mostrarOndeAssistir && (
				<section class="mt-12" aria-labelledby="onde-assistir-titulo">
					<h2
						id="onde-assistir-titulo"
						class="font-display text-2xl tracking-wide text-pipoca"
					>
						Onde assistir
					</h2>
					<p class="mt-4">
						<a
							href={justWatchUrl}
							target="_blank"
							rel="noopener"
							class="font-medium text-pipoca underline-offset-2 transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca"
						>
							Ver onde assistir no JustWatch
						</a>
					</p>
				</section>
			)}

			{temCuriosidades && (
				<section class="mt-12" aria-labelledby="curiosidades-titulo">
					<h2
						id="curiosidades-titulo"
						class="font-display text-2xl tracking-wide text-pipoca"
					>
						Curiosidades
					</h2>
					<ul class="mt-4 list-disc space-y-3 pl-5 text-sm leading-relaxed text-text md:text-base">
						{ficha.curiosidades!.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</section>
			)}

			{temFontes && (
				<p class="mt-10 text-xs text-muted">
					Fontes:{' '}
					{ficha.fontes!.map((fonte, i) => (
						<>
							{i > 0 && ', '}
							<a
								href={fonte.url}
								target="_blank"
								rel="noopener nofollow"
								class="underline-offset-2 hover:text-text hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pipoca"
							>
								{fonte.nome}
							</a>
						</>
					))}
				</p>
			)}
		</>
	)
}

{
	parte === 'inicio' && temTrailer && (
		<script is:inline>
			document.addEventListener('DOMContentLoaded', function () {
				document.querySelectorAll('[data-yt-trailer]').forEach(function (el) {
					el.addEventListener('click', function (ev) {
						ev.preventDefault();
						var id = el.getAttribute('data-yt-trailer');
						if (!id) return;
						var iframe = document.createElement('iframe');
						iframe.src =
							'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1';
						iframe.title = 'Trailer';
						iframe.allow =
							'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
						iframe.allowFullscreen = true;
						iframe.setAttribute('frameborder', '0');
						iframe.className = 'absolute inset-0 h-full w-full';
						el.replaceWith(iframe);
					});
				});
			});
		</script>
	)
}
