---
import { Image } from 'astro:assets';
import logo from '../assets/logo-arte-com-pipoca.png';

interface Props {
	/** Largura em CSS (header menor, hero maior). */
	width?: number;
	class?: string;
	/** No header/hero (acima da dobra) use "eager". */
	loading?: 'eager' | 'lazy';
}

const { width = 180, class: className, loading = 'lazy' } = Astro.props;
---

<Image
	src={logo}
	alt="Arte Com Pipoca"
	width={width}
	format="webp"
	quality="mid"
	loading={loading}
	class:list={['max-w-full', className ?? 'h-auto w-auto']}
	densities={[1, 2]}
/>
